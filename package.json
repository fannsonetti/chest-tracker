{
  "name": "chest-tracker",
  "productName": "Chest Tracker",
  "version": "1.3.1",
  "description": "Always-on-top chest tracker overlay",
  "main": "main.js",
  "scripts": {
    "test": "node --test team-sync.test.js match.test.js notification-sounds.test.js hosted-connection.test.js relay/server.test.js",
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "relay": "node relay/server.js"
  },
  "build": {
    "appId": "com.chesttracker.app",
    "productName": "Chest Tracker",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "match.js",
      "milestones.js",
      "streak-deaths.js",
      "streak-overtakes.js",
      "recap.css",
      "tiers.css",
      "popup.html",
      "popup.js",
      "achievements.css",
      "achievements.js",
      "sound.js",
      "notification-sounds.js",
      "click.wav",
      "icon.png",
      "hosted-connection.js",
      "proof.js",
      "updater.js",
      "options.html",
      "options.css",
      "options.js"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "icon.png",
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "ChestTracker.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "ChestTracker-Setup-${version}.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "fannsonetti",
      "repo": "chest-tracker",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "ws": "^8.22.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fannsonetti/chest-tracker.git"
  }
}
